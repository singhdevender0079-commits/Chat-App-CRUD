<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New chat | WhatsApp Clone</title>
    <link rel="stylesheet" href="/new.css">
</head>
<body>
  <main class="form-shell">
    <a class="back-link" href="/chats">&larr; Back to chats</a>
    <section class="form-card">
      <p class="eyebrow">New conversation</p>
      <h1>Send a message</h1>
      <p class="intro">Create a new chat and keep the conversation moving.</p>
      <form action="/chats" method="post" class="chat-form">
        <label for="from">From</label>
        <input type="text" name="from" id="from" placeholder="Your name" class="name" required>

        <label for="to">To</label>
        <input type="text" name="to" id="to" placeholder="Recipient name" required>

        <label for="msg">Message</label>
        <textarea name="msg" id="msg" placeholder="Write your message here..." required></textarea>

        <button class="button button-primary" type="submit">Send message <span>&rarr;</span></button>
      </form>
    </section>
  </main>
</body>
</html>