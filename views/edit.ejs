<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit chat | WhatsApp Clone</title>
    <link rel="stylesheet" href="/edit.css">
</head>
<body>
    <main class="form-shell">
        <a class="back-link" href="/chats">&larr; Back to chats</a>
        <section class="form-card">
            <p class="eyebrow">Conversation details</p>
            <h1>Edit message</h1>
            <p class="intro">From <strong><%= chat.from %></strong> to <strong><%= chat.To %></strong></p>
            <form method="post" action="/chats/<%= chat._id %>?_method=PUT" class="chat-form">
                <label for="msg">Message</label>
                <textarea name="msg" id="msg" required><%= chat.message %></textarea>
                <button class="button button-primary" type="submit">Save changes <span>&rarr;</span></button>
            </form>
        </section>
    </main>
</body>
</html>